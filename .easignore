# EAS Build uses THIS file instead of .gitignore when it's present, to
# decide which files get uploaded for a cloud build. It mirrors .gitignore
# except it deliberately does NOT exclude assets/models/*.gguf — those files
# must be present in the uploaded project so plugins/withBundledModels.js
# can bake them into the APK during the cloud build. Run
# scripts/setup-models.sh locally before `eas build` so they exist to upload.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
